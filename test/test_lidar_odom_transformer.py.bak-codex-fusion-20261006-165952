#!/usr/bin/env python3
"""用合成 ROS 消息验证三坐标系变换；测试不连接底盘和雷达。"""

import argparse
import math
import os
import subprocess
import tempfile
import time
import unittest
from pathlib import Path

# 限制为本机隔离 DDS 域，合成里程计不会进入实车正在使用的 ROS 图。
os.environ["ROS_DOMAIN_ID"] = "231"
os.environ["ROS_LOCALHOST_ONLY"] = "1"

import numpy as np
import rclpy
import yaml
from nav_msgs.msg import Odometry
from tf2_msgs.msg import TFMessage
from rclpy.qos import QoSProfile, DurabilityPolicy

parser = argparse.ArgumentParser()
parser.add_argument("--binary", required=True)
arguments, remaining = parser.parse_known_args()


def rotation(rpy):
    """独立生成 Rz*Ry*Rx，供测试输入和已知物理姿态使用。"""
    roll, pitch, yaw = rpy
    cr, sr = math.cos(roll), math.sin(roll)
    cp, sp = math.cos(pitch), math.sin(pitch)
    cy, sy = math.cos(yaw), math.sin(yaw)
    return np.array([
        [cy*cp, cy*sp*sr-sy*cr, cy*sp*cr+sy*sr],
        [sy*cp, sy*sp*sr+cy*cr, sy*sp*cr-cy*sr],
        [-sp, cp*sr, cp*cr],
    ])


def quaternion(matrix):
    """从旋转矩阵构造四元数，仅用于生成和读取测试消息。"""
    # 通过对称特征值问题求解，避免复用被测程序的 Eigen 转换逻辑。
    r = matrix
    k = np.array([
        [r[0, 0]-r[1, 1]-r[2, 2], r[0, 1]+r[1, 0], r[0, 2]+r[2, 0], r[2, 1]-r[1, 2]],
        [r[0, 1]+r[1, 0], r[1, 1]-r[0, 0]-r[2, 2], r[1, 2]+r[2, 1], r[0, 2]-r[2, 0]],
        [r[0, 2]+r[2, 0], r[1, 2]+r[2, 1], r[2, 2]-r[0, 0]-r[1, 1], r[1, 0]-r[0, 1]],
        [r[2, 1]-r[1, 2], r[0, 2]-r[2, 0], r[1, 0]-r[0, 1], np.trace(r)],
    ]) / 3.0
    return np.linalg.eigh(k)[1][:, -1]  # x,y,z,w


def rpy(matrix):
    return np.array([
        math.atan2(matrix[2, 1], matrix[2, 2]),
        math.asin(np.clip(-matrix[2, 0], -1.0, 1.0)),
        math.atan2(matrix[1, 0], matrix[0, 0]),
    ])


class TransformerTest(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        rclpy.init()
        cls.node = rclpy.create_node("lio_transform_geometry_test")
        cls.messages = {}
        cls.world_transforms = {}
        cls.tf_sub = cls.node.create_subscription(
            TFMessage, "/tf_static",
            lambda msg: cls.world_transforms.update({t.child_frame_id: t for t in msg.transforms}),
            QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL))
        cls.pub = cls.node.create_publisher(Odometry, "/test/imu_odom", 20)
        cls.sub = cls.node.create_subscription(
            Odometry, "/test/base_odom",
            lambda msg: cls.messages.__setitem__(msg.header.stamp.sec, msg), 20)
        cls.sequence = 1
        cls.process = None
        cls.temp = tempfile.TemporaryDirectory()
        cls.R_il = rotation([0.17, -0.23, 0.31])
        cls.t_il = np.array([-0.011, -0.02329, 0.04412])
        cls.R_bl = rotation([0.2, -0.13, -0.91])
        cls.t_bl = np.array([-0.08, 0.11, 0.45])
        cls.start_transformer(cls.R_il, cls.t_il, cls.t_bl, [0.2, -0.13, -0.91])

    @classmethod
    def start_transformer(cls, R_il, t_il, t_bl, mount_rpy, output_world_frame="camera_init"):
        if cls.process is not None:
            cls.process.terminate()
            cls.process.wait(timeout=5)
        cls.world_transforms.clear()
        cls.R_ib = R_il @ rotation(mount_rpy).T
        cls.t_ib = t_il - cls.R_ib @ t_bl
        parameters = {
            "input_topic": "/test/imu_odom", "output_topic": "/test/base_odom",
            "world_frame": "camera_init", "imu_frame": "body", "base_frame": "base_link",
            # 几何单测显式保留 camera_init；世界基准单测另设为 odom。
            "output_world_frame": output_world_frame,
            "publish_tf": False, "input_covariance_order": "rotation_position",
            "t_imu_lidar": list(map(float, t_il)),
            "R_imu_lidar": list(map(float, R_il.flat)),
            "t_base_lidar": list(map(float, t_bl)),
            "rpy_base_lidar": list(map(float, mount_rpy)),
            "pose_covariance_floor": [0.0]*6,
        }
        path = Path(cls.temp.name) / "parameters.yaml"
        path.write_text(yaml.safe_dump({"lidar_odom_transformer": {"ros__parameters": parameters}}))
        cls.process = subprocess.Popen(
            [arguments.binary, "--ros-args", "--params-file", str(path)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        deadline = time.monotonic() + 8
        while time.monotonic() < deadline:
            rclpy.spin_once(cls.node, timeout_sec=0.05)
            if cls.process.poll() is not None:
                raise AssertionError("Transformer exited during startup")
            if cls.pub.get_subscription_count() > 0:
                return
        raise AssertionError("DDS discovery timeout")

    @classmethod
    def tearDownClass(cls):
        if cls.process is not None:
            cls.process.terminate()
            cls.process.wait(timeout=5)
        cls.node.destroy_node()
        rclpy.shutdown()
        cls.temp.cleanup()

    def exchange(self, R_wi, t_wi, covariance=None, frames=("camera_init", "body")):
        msg = Odometry()
        key = type(self).sequence
        type(self).sequence += 1
        msg.header.stamp.sec = key
        msg.header.stamp.nanosec = 123456789
        msg.header.frame_id, msg.child_frame_id = frames
        p, q = msg.pose.pose.position, msg.pose.pose.orientation
        p.x, p.y, p.z = map(float, t_wi)
        q.x, q.y, q.z, q.w = map(float, quaternion(R_wi))
        if covariance is not None:
            # 本机 FAST-LIO 消息是 [rot,pos] 顺序。
            order = [3, 4, 5, 0, 1, 2]
            msg.pose.covariance = list(map(float, covariance[np.ix_(order, order)].flat))
        deadline = time.monotonic() + 3
        self.pub.publish(msg)
        last_publish = time.monotonic()
        while time.monotonic() < deadline:
            # 重启软件节点后允许 DDS 发现延迟；同一合成观测可重复发送。
            if time.monotonic() - last_publish > 0.1:
                self.pub.publish(msg)
                last_publish = time.monotonic()
            rclpy.spin_once(self.node, timeout_sec=0.05)
            if key in self.messages:
                return self.messages.pop(key)
        return None

    def test_01_nonidentity_extrinsics_and_rotation(self):
        rng = np.random.default_rng(62)
        for _ in range(8):
            # 先指定实际车体姿态，再构造 IMU 的观测，避免只测试同轴、零平移。
            R_wb = rotation(rng.uniform([-0.5, -0.5, -2.8], [0.5, 0.5, 2.8]))
            t_wb = rng.uniform(-10.0, 10.0, 3)
            R_wi = R_wb @ self.R_ib.T
            t_wi = t_wb - R_wi @ self.t_ib
            output = self.exchange(R_wi, t_wi)
            self.assertIsNotNone(output)
            p, q = output.pose.pose.position, output.pose.pose.orientation
            np.testing.assert_allclose([p.x, p.y, p.z], t_wb, atol=1e-10)
            expected = quaternion(R_wb)
            self.assertAlmostEqual(abs(np.dot([q.x, q.y, q.z, q.w], expected)), 1.0, places=10)
            self.assertEqual(output.header.frame_id, "camera_init")
            self.assertEqual(output.child_frame_id, "base_link")
            self.assertEqual(output.header.stamp.nanosec, 123456789)
            np.testing.assert_allclose(np.diag(np.array(output.twist.covariance).reshape(6, 6)), 1e6)

    def test_02_covariance_against_numerical_jacobian(self):
        R_wi = rotation([0.23, -0.15, 0.41])
        t_wi = np.array([1.0, -2.0, 0.4])
        rng = np.random.default_rng(8)
        a = rng.normal(size=(6, 6))
        covariance = a @ a.T * 0.001
        output = self.exchange(R_wi, t_wi, covariance)
        self.assertIsNotNone(output)

        def evaluate(delta):
            # 对 IMU 局部旋转作右扰动；使用中心差分验证杠杆臂和角度变换。
            R_perturbed = R_wi @ rotation(delta[3:])
            R_wb = R_perturbed @ self.R_ib
            t_wb = t_wi + delta[:3] + R_perturbed @ self.t_ib
            return np.r_[t_wb, rpy(R_wb)]

        jacobian = np.zeros((6, 6))
        for i in range(6):
            delta = np.zeros(6)
            delta[i] = 1e-6
            jacobian[:, i] = (evaluate(delta) - evaluate(-delta)) / 2e-6
        expected = jacobian @ covariance @ jacobian.T
        actual = np.array(output.pose.covariance).reshape(6, 6)
        np.testing.assert_allclose(actual, expected, rtol=1e-7, atol=1e-10)

    def test_03_wrong_frames_are_rejected(self):
        self.assertIsNone(self.exchange(np.eye(3), np.zeros(3), frames=("odom", "body")))

    def test_04_actual_mid360_mount(self):
        self.start_transformer(np.eye(3), self.t_il, np.array([0.0, 0.0, 0.145]),
                               [0.0, 0.0, -math.pi/2])
        output = self.exchange(np.eye(3), np.zeros(3))
        self.assertIsNotNone(output)
        p, q = output.pose.pose.position, output.pose.pose.orientation
        np.testing.assert_allclose([p.x, p.y, p.z], [-0.011, -0.02329, -0.10088], atol=1e-12)
        self.assertAlmostEqual(abs(q.z), math.sqrt(0.5), places=10)
        self.assertAlmostEqual(abs(q.w), math.sqrt(0.5), places=10)


    def test_05_odom_origin_followup_and_world_tf(self):
        self.start_transformer(self.R_il, self.t_il, self.t_bl,
                               [0.2, -0.13, -0.91], output_world_frame="odom")
        initial_R = rotation([0.2, -0.15, 1.2])
        initial_p = np.array([3.0, -4.0, 0.7])
        R_oc = rotation([0.0, 0.0, -1.2])
        first_R_i = initial_R @ self.R_ib.T
        first_p_i = initial_p - first_R_i @ self.t_ib
        first = self.exchange(first_R_i, first_p_i)
        self.assertIsNotNone(first)
        self.assertEqual(first.header.frame_id, "odom")
        self.assertEqual(first.child_frame_id, "base_link")
        np.testing.assert_allclose(
            [first.pose.pose.position.x, first.pose.pose.position.y,
             first.pose.pose.position.z], 0.0, atol=1e-10)
        first_q = first.pose.pose.orientation
        self.assertAlmostEqual(abs(np.dot(
            [first_q.x, first_q.y, first_q.z, first_q.w],
            quaternion(rotation([0.2, -0.15, 0.0])))), 1.0, places=10)

        next_R = rotation([-0.1, 0.22, 1.7])
        next_p = np.array([4.0, -2.0, 1.2])
        next_R_i = next_R @ self.R_ib.T
        next_p_i = next_p - next_R_i @ self.t_ib
        output = self.exchange(next_R_i, next_p_i)
        p_out, q_out = output.pose.pose.position, output.pose.pose.orientation
        np.testing.assert_allclose([p_out.x, p_out.y, p_out.z],
                                   R_oc @ (next_p-initial_p), atol=1e-10)
        self.assertAlmostEqual(abs(np.dot(
            [q_out.x, q_out.y, q_out.z, q_out.w],
            quaternion(R_oc @ next_R))), 1.0, places=10)
        deadline = time.monotonic()+2.0
        while "camera_init" not in self.world_transforms and time.monotonic() < deadline:
            rclpy.spin_once(self.node, timeout_sec=0.05)
        tf = self.world_transforms["camera_init"]
        self.assertEqual(tf.header.frame_id, "odom")
        t = tf.transform.translation
        np.testing.assert_allclose([t.x, t.y, t.z], -R_oc @ initial_p, atol=1e-10)
        q = tf.transform.rotation
        self.assertAlmostEqual(abs(np.dot([q.x, q.y, q.z, q.w],
                                          quaternion(R_oc))), 1.0, places=10)

    def test_06_odom_covariance_against_numerical_jacobian(self):
        self.start_transformer(self.R_il, self.t_il, self.t_bl,
                               [0.2, -0.13, -0.91], output_world_frame="odom")
        initial_R = rotation([0.1, -0.08, 0.9])
        initial_p = np.array([5.0, -1.0, 0.3])
        R_oc = rotation([0.0, 0.0, -0.9])
        R_first_i = initial_R @ self.R_ib.T
        self.assertIsNotNone(self.exchange(R_first_i, initial_p-R_first_i @ self.t_ib))
        R_wi = rotation([0.23, -0.15, 0.41])
        t_wi = np.array([1.0, -2.0, 0.4])
        a = np.random.default_rng(82).normal(size=(6, 6))
        covariance = a @ a.T * 0.001
        output = self.exchange(R_wi, t_wi, covariance)

        def evaluate(delta):
            # 独立有限差分覆盖完整 IMU → 车体 → odom 链路及非对角协方差。
            R_i = R_wi @ rotation(delta[3:])
            p_base = t_wi+delta[:3]+R_i @ self.t_ib
            return np.r_[R_oc @ (p_base-initial_p), rpy(R_oc @ R_i @ self.R_ib)]

        jacobian = np.zeros((6, 6))
        for i in range(6):
            delta = np.zeros(6)
            delta[i] = 1e-6
            jacobian[:, i] = (evaluate(delta)-evaluate(-delta))/2e-6
        np.testing.assert_allclose(
            np.array(output.pose.covariance).reshape(6, 6),
            jacobian @ covariance @ jacobian.T, rtol=1e-7, atol=1e-10)


if __name__ == "__main__":
    unittest.main(argv=[__file__] + remaining)
